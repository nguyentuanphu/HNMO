@page "/vault-chaos-rewards"
@attribute [Authorize(Policy = AdminPolicies.Administrator)]

@using HNMO.DataModel.Configuration
@using HNMO.DataModel.Configuration.Items
@using HNMO.GameLogic.PlugIns.GameplayRules
@using HNMO.Web.AdminPanel.Operations
@using HNMO.Web.AdminPanel.Properties

<PageTitle>HNMO: @L("Chaos rates, Multi-vault & Event rewards", "Tỉ lệ Chaos, Nhiều rương & Thưởng sự kiện")</PageTitle>
<Breadcrumb IsFirstFromRoot="true" Caption="@L("Chaos rates, Multi-vault & Event rewards", "Tỉ lệ Chaos, Nhiều rương & Thưởng sự kiện")" />
<div class="d-flex align-items-center gap-2 mb-2">
    <h1 class="mb-0">@L("Chaos rates, Multi-vault & Event rewards", "Tỉ lệ Chaos, Nhiều rương & Thưởng sự kiện")</h1>
    <button type="button" class="btn btn-sm btn-outline-info" id="vcr-help-btn" title="@L("How to use this page", "Hướng dẫn sử dụng trang này")" @onclick="() => this._showHelp = !this._showHelp">?</button>
</div>
<p class="text-muted">@L("Configure Chaos Machine success rates (shown live to players), multi-vault counts & coin unlock costs, and mini-game rewards per event level (Blood Castle, Devil Square, Chaos Castle, Illusion Temple).", "Chỉnh tỉ lệ xoay Chaos (hiện trực tiếp cho người chơi), giới hạn nhiều rương & giá mở bằng xu, và phần thưởng từng cấp của Huyết Lâu, Quảng Trường Quỷ, Hỗn Nguyên Lâu, Bạch Long Điện.")</p>

@if (this._showHelp)
{
    <div class="alert alert-info" role="region" id="vcr-help">
        <strong>@L("How to use this page:", "Hướng dẫn:")</strong>
        <ul class="mb-0 mt-1">
            <li>@L("Chaos Machine Rates (14.4) and Multi-Vault (14.5) are OFF until Enabled is checked and saved.", "Tỉ lệ Chaos (14.4) và Nhiều rương (14.5) mặc định TẮT cho tới khi bạn tick Bật và Lưu.")</li>
            <li>@L("Players can switch vaults in-game with /vault <index> (vault must be closed first) or buy an extra slot with /vault buy.", "Trong game người chơi gõ /vault <số> (khi đang đóng rương) để đổi rương hoặc /vault buy để mua thêm rương.")</li>
            <li>@L("Event Rewards (14.7) edit MiniGameDefinition rewards per event level directly with audit logging.", "Thưởng sự kiện (14.7) sửa trực tiếp từng phần thưởng theo cấp sự kiện và có ghi nhật ký kiểm toán.")</li>
        </ul>
    </div>
}

@if (this._isLoading)
{
    <p>@Resources.Loading</p>
}
else
{
    <section class="card mb-3" id="vcr-chaos-card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h5 mb-0">@L("1. Chaos Machine success rates", "1. Tỉ lệ thành công Máy Chaos")</h2>
                <div class="form-check">
                    <input class="form-check-input" id="vcr-chaos-enabled" type="checkbox" @bind="this._chaosConfig.Enabled" />
                    <label class="form-check-label" for="vcr-chaos-enabled" title="@L("Enable custom Chaos Machine rates", "Bật ghi đè tỉ lệ Máy Chaos")">@L("Enabled", "Bật")</label>
                </div>
            </div>
            <div class="row g-2 align-items-end mb-2">
                <div class="col-md-4">
                    <label class="form-label" for="vcr-chaos-mult" title="@L("Server-wide multiplier applied to recipes (1.0 = normal, 1.5 = +50%)", "Hệ số nhân tỉ lệ toàn máy chủ (1.0 = mặc định)")">@L("Server-wide multiplier", "Hệ số toàn máy chủ")</label>
                    <input class="form-control form-control-sm" id="vcr-chaos-mult" type="number" step="0.1" min="0.1" max="10" @bind="this._chaosConfig.ServerWideMultiplier" />
                </div>
                <div class="col-md-8 d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="vcr-chaos-add" @onclick="this.AddChaosOverride">@L("+ Add recipe override", "+ Thêm công thức")</button>
                    <button type="button" class="btn btn-sm btn-primary" id="vcr-chaos-save" disabled="@this._isSaving" @onclick="this.SaveChaosAsync">@L("Save Chaos rates", "Lưu tỉ lệ Chaos")</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0" id="vcr-chaos-table">
                    <thead>
                        <tr>
                            <th>@L("Recipe #", "Mã công thức")</th>
                            <th>@L("Recipe name", "Tên công thức")</th>
                            <th>@L("Fixed % override (blank=auto)", "Tỉ lệ cố định % (trống=tính chuẩn)")</th>
                            <th>@L("Multiplier", "Hệ số riêng")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < this._chaosConfig.RecipeOverrides.Count; i++)
                        {
                            var idx = i;
                            var r = this._chaosConfig.RecipeOverrides[idx];
                            <tr>
                                <td><input class="form-control form-control-sm" type="number" min="0" max="255" @bind="r.RecipeNumber" /></td>
                                <td><input class="form-control form-control-sm" @bind="r.RecipeName" placeholder="@this.LookupRecipeName(r.RecipeNumber)" /></td>
                                <td><input class="form-control form-control-sm" type="number" min="0" max="100" @bind="r.SuccessRateOverridePercent" /></td>
                                <td><input class="form-control form-control-sm" type="number" step="0.1" min="0.1" max="10" @bind="r.RateMultiplier" /></td>
                                <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => this._chaosConfig.RecipeOverrides.RemoveAt(idx)">×</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="card mb-3" id="vcr-vault-card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h5 mb-0">@L("2. Multi-vault (/vault)", "2. Nhiều rương đồ (/vault)")</h2>
                <div class="form-check">
                    <input class="form-check-input" id="vcr-vault-enabled" type="checkbox" @bind="this._vaultConfig.Enabled" />
                    <label class="form-check-label" for="vcr-vault-enabled" title="@L("Enable /vault switching and extra vaults", "Bật đổi rương và mở thêm rương")">@L("Enabled", "Bật")</label>
                </div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-2">
                    <label class="form-label" for="vcr-v-def" title="@L("Free vaults unlocked for every account", "Số rương miễn phí mặc định")">@L("Default vaults", "Mặc định")</label>
                    <input class="form-control form-control-sm" id="vcr-v-def" type="number" min="1" max="20" @bind="this._vaultConfig.DefaultVaultCount" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="vcr-v-max" title="@L("Maximum vaults allowed per account", "Tối đa số rương mỗi tài khoản")">@L("Max vaults", "Tối đa")</label>
                    <input class="form-control form-control-sm" id="vcr-v-max" type="number" min="1" max="30" @bind="this._vaultConfig.MaxVaultsPerAccount" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="vcr-v-vip" title="@L("Extra vaults granted while VIP active", "Số rương cộng thêm khi có VIP")">@L("VIP bonus vaults", "Thêm cho VIP")</label>
                    <input class="form-control form-control-sm" id="vcr-v-vip" type="number" min="0" max="20" @bind="this._vaultConfig.VipExtraVaults" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="vcr-v-cost" title="@L("Coin price for /vault buy (0 = disabled)", "Giá xu cho lệnh /vault buy (0 = tắt)")">@L("Buy extra cost", "Giá mua thêm")</label>
                    <input class="form-control form-control-sm" id="vcr-v-cost" type="number" min="0" @bind="this._vaultConfig.PurchaseExtraVaultCost" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="vcr-v-coin">@L("Coin currency", "Loại xu")</label>
                    <select class="form-select form-select-sm" id="vcr-v-coin" @bind="this._vaultConfig.PurchaseCoinType">
                        @foreach (var ct in Enum.GetValues<CashShopCoinType>())
                        {
                            <option value="@ct">@ct</option>
                        }
                    </select>
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-primary" id="vcr-vault-save" disabled="@this._isSaving" @onclick="this.SaveVaultAsync">@L("Save multi-vault settings", "Lưu cài đặt rương")</button>
        </div>
    </section>

    <section class="card" id="vcr-rewards-card">
        <div class="card-body">
            <h2 class="h5">@L("3. Event rewards editor (per event level)", "3. Chỉnh phần thưởng sự kiện (theo cấp)")</h2>
            <div class="row g-2 align-items-end mb-2">
                <div class="col-md-5">
                    <label class="form-label" for="vcr-ev-select">@L("Select event & level", "Chọn sự kiện & cấp")</label>
                    <select class="form-select form-select-sm" id="vcr-ev-select" value="@this._selectedDefinitionId" @onchange="this.OnEventChanged">
                        @foreach (var def in this._definitions)
                        {
                            <option value="@def.Id">@def.Type — Lv.@def.Level (@def.Name)</option>
                        }
                    </select>
                </div>
                <div class="col-md-7 d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="vcr-ev-add" disabled="@(this._selectedDefinitionId == Guid.Empty)" @onclick="this.AddRewardRow">@L("+ Add reward", "+ Thêm phần thưởng")</button>
                    <button type="button" class="btn btn-sm btn-primary" id="vcr-ev-save" disabled="@(this._isSaving || this._selectedDefinitionId == Guid.Empty)" @onclick="this.SaveEventRewardsAsync">@L("Save level rewards", "Lưu thưởng cấp này")</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0" id="vcr-rewards-table">
                    <thead>
                        <tr>
                            <th>@L("Rank", "Hạng")</th>
                            <th>@L("Condition", "Điều kiện")</th>
                            <th>@L("Reward type", "Loại thưởng")</th>
                            <th>@L("Amount", "Số lượng")</th>
                            <th>@L("Item drop group", "Nhóm rớt đồ")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < this._editableRewards.Count; i++)
                        {
                            var idx = i;
                            var r = this._editableRewards[idx];
                            <tr>
                                <td><input class="form-control form-control-sm" type="number" @bind="r.Rank" /></td>
                                <td>
                                    <select class="form-select form-select-sm" @bind="r.RequiredSuccess">
                                        @foreach (var flag in Enum.GetValues<MiniGameSuccessFlags>())
                                        {
                                            <option value="@flag">@flag</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select class="form-select form-select-sm" @bind="r.RewardType">
                                        @foreach (var rt in Enum.GetValues<MiniGameRewardType>())
                                        {
                                            <option value="@rt">@rt</option>
                                        }
                                    </select>
                                </td>
                                <td><input class="form-control form-control-sm" type="number" @bind="r.RewardAmount" /></td>
                                <td>
                                    <select class="form-select form-select-sm" @bind="r.ItemRewardGroupId">
                                        <option value="">-</option>
                                        @foreach (var g in this._dropGroups)
                                        {
                                            <option value="@g.Id">@g.Label</option>
                                        }
                                    </select>
                                </td>
                                <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => this._editableRewards.RemoveAt(idx)">×</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
}
