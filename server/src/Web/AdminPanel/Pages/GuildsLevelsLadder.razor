@page "/guilds-levels-ladder"
@attribute [Authorize(Policy = AdminPolicies.Administrator)]

@using HNMO.DataModel.Configuration
@using HNMO.GameLogic.PlugIns.Guilds
@using HNMO.Web.AdminPanel.Properties
@using HNMO.Web.AdminPanel.Services

<PageTitle>HNMO: @Resources.GuildsLevelsAndLadder</PageTitle>
<Breadcrumb IsFirstFromRoot="true" Caption="@Resources.GuildsLevelsAndLadder" />
<h1>@Resources.GuildsLevelsAndLadder</h1>
<p class="text-muted">@Resources.GuildsPageDescription</p>

@if (this._isLoading)
{
    <p>@Resources.Loading</p>
}
else if (this._configuration is not { } c)
{
    <div class="alert alert-warning" role="status">@Resources.GuildsNotInstalled</div>
}
else
{
    @if (this._errors.Count > 0)
    {
        <div class="alert alert-danger" role="alert" id="guilds-errors">
            <ul class="mb-0">
                @foreach (var error in this._errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <section class="card mb-3">
        <div class="card-body">
            <h2 class="h5">@Resources.GuildsGeneral</h2>
            <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" id="guilds-active" @bind="this._isActive" />
                <label class="form-check-label" for="guilds-active">@Resources.GuildsActive</label>
            </div>
            <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" id="guilds-announce" @bind="c.AnnounceInGame" />
                <label class="form-check-label" for="guilds-announce">@Resources.GuildsAnnounceInGame</label>
            </div>
            <div class="row g-2">
                <div class="col-sm-3">
                    <label class="form-label" for="guilds-cap">@Resources.GuildsDailyCap</label>
                    <input class="form-control" type="number" min="0" id="guilds-cap" @bind="c.DailyCapPerMember" />
                </div>
                <div class="col-sm-3">
                    <label class="form-label" for="guilds-zone">@Resources.GuildsTimeZone</label>
                    <input class="form-control" id="guilds-zone" @bind="c.TimeZone" />
                </div>
                <div class="col-sm-5">
                    <label class="form-label" for="guilds-file">@Resources.GuildsFile</label>
                    <input class="form-control" id="guilds-file" @bind="c.FileName" />
                </div>
            </div>
            <p class="form-text mb-0">@Resources.GuildsDailyCapHint</p>
        </div>
    </section>

    <section class="card mb-3">
        <div class="card-body">
            <h2 class="h5">@Resources.GuildsSources</h2>
            <p class="form-text">@Resources.GuildsSourcesHint</p>
            <table class="table table-sm align-middle" id="guilds-sources" style="max-width: 40rem">
                <thead>
                <tr>
                    <th>@Resources.MissionsOn</th>
                    <th>@Resources.GuildsSource</th>
                    <th>@Resources.GuildsXp</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var source in Enum.GetValues<GuildXpSource>())
                {
                    var setting = c.Source(source);
                    <tr data-source="@source">
                        <td><input class="form-check-input source-on" type="checkbox" @bind="setting.Enabled" aria-label="@Resources.MissionsOn" /></td>
                        <td>@SourceCaption(source)</td>
                        <td><input class="form-control form-control-sm source-xp" style="width: 7rem" type="number" min="0" @bind="setting.Xp" aria-label="@Resources.GuildsXp" /></td>
                    </tr>
                }
                </tbody>
            </table>
            <div class="row g-2">
                <div class="col-sm-4">
                    <label class="form-label" for="guilds-online-minutes">@Resources.GuildsOnlineMinutes</label>
                    <input class="form-control" type="number" min="1" id="guilds-online-minutes" @bind="c.OnlineMinutes" />
                </div>
                <div class="col-sm-4">
                    <label class="form-label" for="guilds-siege-bonus">@Resources.GuildsSiegeLadderBonus</label>
                    <input class="form-control" type="number" min="0" id="guilds-siege-bonus" @bind="c.CastleSiegeLadderBonus" />
                </div>
            </div>
        </div>
    </section>

    <section class="card mb-3">
        <div class="card-body">
            <h2 class="h5">@Resources.GuildsLevels</h2>
            <p class="form-text">@Resources.GuildsLevelsHint</p>
            <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" id="guilds-buffs" @bind="c.BuffsEnabled" />
                <label class="form-check-label" for="guilds-buffs">@Resources.GuildsBuffsEnabled</label>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-sm-4">
                    <label class="form-label" for="guilds-buff-en">@Resources.GuildsBuffNameEn</label>
                    <input class="form-control" id="guilds-buff-en" @bind="c.BuffNameEn" />
                </div>
                <div class="col-sm-4">
                    <label class="form-label" for="guilds-buff-vi">@Resources.GuildsBuffNameVi</label>
                    <input class="form-control" id="guilds-buff-vi" @bind="c.BuffNameVi" />
                </div>
            </div>
            <table class="table table-sm align-middle" id="guilds-levels" style="max-width: 50rem">
                <thead>
                <tr>
                    <th>@Resources.GuildsLevel</th>
                    <th>@Resources.GuildsLevelXp</th>
                    <th>@Resources.GuildsExperiencePercent</th>
                    <th>@Resources.GuildsZenPercent</th>
                    <th>@Resources.GuildsDefense</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var level in this._levels)
                {
                    <tr data-level="@level.Level">
                        <td><input class="form-control form-control-sm level-number" style="width: 5rem" type="number" min="1" @bind="level.Level" aria-label="@Resources.GuildsLevel" /></td>
                        <td><input class="form-control form-control-sm level-xp" style="width: 9rem" type="number" min="0" @bind="level.Xp" aria-label="@Resources.GuildsLevelXp" /></td>
                        <td><input class="form-control form-control-sm level-exp" style="width: 6rem" type="number" min="0" step="0.5" @bind="level.ExperiencePercent" aria-label="@Resources.GuildsExperiencePercent" /></td>
                        <td><input class="form-control form-control-sm level-zen" style="width: 6rem" type="number" min="0" step="0.5" @bind="level.ZenPercent" aria-label="@Resources.GuildsZenPercent" /></td>
                        <td><input class="form-control form-control-sm level-defense" style="width: 6rem" type="number" min="0" @bind="level.Defense" aria-label="@Resources.GuildsDefense" /></td>
                        <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => this.RemoveLevel(level)">@Resources.Remove</button></td>
                    </tr>
                }
                </tbody>
            </table>
            <button type="button" class="btn btn-outline-primary btn-sm" id="guilds-add-level" @onclick="this.AddLevel">@Resources.GuildsAddLevel</button>
        </div>
    </section>

    <section class="card mb-3">
        <div class="card-body">
            <h2 class="h5">@Resources.GuildsLadder</h2>
            <p class="form-text">@Resources.GuildsLadderHint</p>
            <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" id="guilds-ladder-on" @bind="c.LadderEnabled" />
                <label class="form-check-label" for="guilds-ladder-on">@Resources.GuildsLadderEnabled</label>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-sm-4">
                    <label class="form-label" for="guilds-ladder-min">@Resources.GuildsLadderMinimumXp</label>
                    <input class="form-control" type="number" min="0" id="guilds-ladder-min" @bind="c.LadderMinimumXp" />
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle" id="guilds-rewards">
                    <thead>
                    <tr>
                        <th>@Resources.GuildsRankFrom</th>
                        <th>@Resources.GuildsRankTo</th>
                        <th>@Resources.GuildsCoinsPerMember</th>
                        <th>@Resources.GuildsMasterBonus</th>
                        <th>@Resources.CashShopCoinType</th>
                        <th>@Resources.GuildsZenPerMember</th>
                        <th>@Resources.MissionsItems</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in this._rewards)
                    {
                        var r = row.Reward;
                        <tr data-rank="@r.RankFrom">
                            <td><input class="form-control form-control-sm reward-from" style="width: 5rem" type="number" min="1" @bind="r.RankFrom" aria-label="@Resources.GuildsRankFrom" /></td>
                            <td><input class="form-control form-control-sm reward-to" style="width: 5rem" type="number" min="1" @bind="r.RankTo" aria-label="@Resources.GuildsRankTo" /></td>
                            <td><input class="form-control form-control-sm reward-coins" style="width: 7rem" type="number" min="0" @bind="r.CoinsPerMember" aria-label="@Resources.GuildsCoinsPerMember" /></td>
                            <td><input class="form-control form-control-sm reward-master" style="width: 7rem" type="number" min="0" @bind="r.MasterBonusCoins" aria-label="@Resources.GuildsMasterBonus" /></td>
                            <td>
                                <select class="form-select form-select-sm reward-coin-type" style="width: auto" @bind="r.CoinType" aria-label="@Resources.CashShopCoinType">
                                    @foreach (var coinType in Enum.GetValues<CashShopCoinType>())
                                    {
                                        <option value="@coinType">@CashShopCoinCaption.Get(coinType)</option>
                                    }
                                </select>
                            </td>
                            <td><input class="form-control form-control-sm reward-zen" style="width: 8rem" type="number" min="0" @bind="r.ZenPerMember" aria-label="@Resources.GuildsZenPerMember" /></td>
                            <td><input class="form-control form-control-sm reward-items" style="min-width: 10rem" @bind="row.Items.ItemsText" placeholder="14 13 0 1" title="@Resources.MissionsItemsHint" aria-label="@Resources.MissionsItems" /></td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => this.RemoveReward(row)">@Resources.Remove</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <button type="button" class="btn btn-outline-primary btn-sm" id="guilds-add-reward" @onclick="this.AddReward">@Resources.GuildsAddReward</button>
        </div>
    </section>

    <div class="d-flex gap-2 mb-4">
        <button type="button" class="btn btn-primary" id="guilds-save" disabled="@this._isSaving" @onclick="this.SaveAsync">@Resources.Save</button>
        <button type="button" class="btn btn-outline-secondary" disabled="@this._isSaving" @onclick="this.LoadAsync">@Resources.GuildsReload</button>
    </div>

    @if (this._engine is { } engine)
    {
        var now = DateTime.UtcNow;
        var ladder = engine.Ladder(now);
        var last = engine.LastWeek(now);
        var sieges = engine.Sieges();
        <section class="card mb-3">
            <div class="card-body">
                <h2 class="h5">@Resources.GuildsThisWeek</h2>
                <p class="form-text">@string.Format(Resources.GuildsWeekEnds, Sydney(engine.Clock.NextWeekStart(now), engine))</p>
                @if (ladder.Count == 0)
                {
                    <p class="text-muted" id="guilds-ladder-empty">@Resources.GuildsNoPoints</p>
                }
                else
                {
                    <table class="table table-sm" id="guilds-ladder" style="max-width: 40rem">
                        <thead><tr><th>#</th><th>@Resources.GuildsGuild</th><th>@Resources.GuildsLevel</th><th>@Resources.GuildsPoints</th></tr></thead>
                        <tbody>
                        @foreach (var entry in ladder)
                        {
                            <tr><td>@entry.Rank</td><td>@entry.Progress.Name</td><td>@engine.LevelOf(entry.Progress.Xp)</td><td>@entry.Progress.WeekXp.ToString("N0")</td></tr>
                        }
                        </tbody>
                    </table>
                }

                <h3 class="h6 mt-3">@Resources.GuildsLastWeek</h3>
                @if (last is null || last.Lines.Count == 0)
                {
                    <p class="text-muted">@Resources.GuildsNoLastWeek</p>
                }
                else
                {
                    <p class="form-text">@string.Format(Resources.GuildsWeekOf, last.Week)</p>
                    <table class="table table-sm" id="guilds-last-week" style="max-width: 40rem">
                        <thead><tr><th>#</th><th>@Resources.GuildsGuild</th><th>@Resources.GuildsPoints</th><th>@Resources.GuildsCoinsPerMember</th><th>@Resources.GuildsPaidMembers</th></tr></thead>
                        <tbody>
                        @foreach (var line in last.Lines)
                        {
                            <tr><td>@line.Rank</td><td>@line.Name</td><td>@line.Xp.ToString("N0")</td><td>@line.CoinsPerMember</td><td>@line.PaidMembers</td></tr>
                        }
                        </tbody>
                    </table>
                }

                <h3 class="h6 mt-3">@Resources.GuildsSieges</h3>
                @if (sieges.Count == 0)
                {
                    <p class="text-muted">@Resources.GuildsNoSieges</p>
                }
                else
                {
                    <ul id="guilds-sieges">
                        @foreach (var siege in sieges)
                        {
                            <li>@Sydney(siege.AtUtc, engine): @siege.Name</li>
                        }
                    </ul>
                }
            </div>
        </section>
    }
}
