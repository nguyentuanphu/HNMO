@page "/api-keys"

@using HNMO.Web.AdminPanel.Properties
@attribute [Authorize(Policy = AdminPolicies.Administrator)]

@{
    var title = Resources.ApiKeys;
}
<PageTitle>HNMO: @title</PageTitle>
<Breadcrumb IsFirstFromRoot="true" Caption="@title" />
<div class="page-help mb-3">
<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
    <h1 class="mb-0">@title</h1>
    <button type="button" id="api-keys-help-toggle" class="btn btn-sm btn-outline-info" title="@Resources.ApiKeysHintHelp"
            aria-controls="api-keys-help" aria-expanded="@(this._showHelp ? "true" : "false")" @onclick="@(() => this._showHelp = !this._showHelp)">
        <span class="oi oi-question-mark" aria-hidden="true"></span> @Resources.ApiKeysHelpTitle
    </button>
</div>

@if (this._showHelp)
{
    <div id="api-keys-help" class="alert alert-info" role="note" aria-labelledby="api-keys-help-toggle">
        <p>@Resources.ApiKeysHelpWhat</p>
        <p>@Resources.ApiKeysHelpWhen</p>
        <p>@Resources.ApiKeysHelpCreate</p>
        <p>@Resources.ApiKeysHelpButtons</p>
        <p class="mb-0">@Resources.ApiKeysHelpSafety</p>
    </div>
}
</div>

<p class="text-muted">@Resources.ApiKeysDescription</p>

@if (this._createdKey is { Length: > 0 } createdKey)
{
    <div class="alert alert-warning" role="alert">
        <h5 class="alert-heading">
            <span class="oi oi-key" aria-hidden="true"></span> @Resources.ApiKeyShownOnce
        </h5>
        <p>@Resources.ApiKeyShownOnceDescription</p>
        <div class="input-group">
            <input type="text" class="form-control font-monospace" readonly value="@createdKey" aria-label="@Resources.ApiKeys"/>
            <button type="button" class="btn btn-primary" title="@Resources.ApiKeysHintCopy" @onclick="@this.CopyCreatedKeyAsync">
                <span class="oi oi-clipboard" aria-hidden="true"></span> @Resources.CopyToClipboard
            </button>
        </div>
        <button type="button" class="btn btn-sm btn-secondary mt-3" title="@Resources.ApiKeysHintClose" @onclick="@(() => this._createdKey = null)">@Resources.Close</button>
    </div>
}

@if (this._isLoading)
{
    <p>@Resources.Loading</p>
}
else
{
    @if (this._apiKeys.Any(this.IsCreatedBeforeFirstUser))
    {
        <div class="alert alert-warning" role="alert">
            <span class="oi oi-warning" aria-hidden="true"></span> @Resources.ApiKeysCreatedBeforeFirstUserHint
        </div>
    }

