@page "/api-keys"

@using HNMO.Web.AdminPanel.Properties
@attribute [Authorize(Policy = AdminPolicies.Administrator)]

@{
    var title = Resources.ApiKeys;
}
<PageTitle>HNMO: @title</PageTitle>
<Breadcrumb IsFirstFromRoot="true" Caption="@title" />
<h1>@title</h1>
<PageHelp Text="@HNMO.Web.AdminPanel.Properties.Resources.PageHelpTextApiKeys" />

<p class="text-muted">@Resources.ApiKeysDescription</p>

@if (this._createdKey is { Length: > 0 } createdKey)
{
    <div class="alert alert-warning" role="alert">
        <h5 class="alert-heading">
            <span class="oi oi-key" aria-hidden="true"></span> @Resources.ApiKeyShownOnce
        </h5>
        <p>@Resources.ApiKeyShownOnceDescription</p>
        <div class="input-group">
            <input type="text" class="form-control font-monospace" readonly value="@createdKey" aria-label="@Resources.ApiKeys"/>
            <button type="button" class="btn btn-primary" @onclick="@this.CopyCreatedKeyAsync" title="@HNMO.Web.AdminPanel.Properties.Resources.PageHelpHintCopy">
                <span class="oi oi-clipboard" aria-hidden="true"></span> @Resources.CopyToClipboard
            </button>
        </div>
        <button type="button" class="btn btn-sm btn-secondary mt-3" @onclick="@(() => this._createdKey = null)" title="@HNMO.Web.AdminPanel.Properties.Resources.PageHelpHintCancel">@Resources.Close</button>
    </div>
}

@if (this._isLoading)
{
    <p>@Resources.Loading</p>
}
else
{
    @if (this._apiKeys.Any(this.IsCreatedBeforeFirstUser))
    {
        <div class="alert alert-warning" role="alert">
            <span class="oi oi-warning" aria-hidden="true"></span> @Resources.ApiKeysCreatedBeforeFirstUserHint
        </div>
    }

    <div>
        <table class="table table-striped table-hover">
            <thead>
            <tr>
                <th class="col-4">@Resources.ApiKeyName</th>
                <th class="col-2">@Resources.ApiKeyPrefix</th>
                <th class="col-2">@Resources.Role</th>
                <th>@HNMO.Web.AdminPanel.Services.ApiKeyToolGroupResources.Caption</th>
                <th class="col-4">@Resources.Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var apiKey in this._apiKeys)
            {
                <tr class="@(apiKey.IsDisabled ? "opacity-50" : null)">
                    <td>
                        @apiKey.Name
                        @if (this.IsCreatedBeforeFirstUser(apiKey))
                        {
                            <span class="badge bg-warning text-dark ms-1">@Resources.ApiKeyCreatedBeforeFirstUser</span>
                        }
                    </td>
                    <td><code>@apiKey.KeyPrefix…</code></td>
                    <td>@HNMO.Web.AdminPanel.Auth.RoleCaption.Get(apiKey.Roles)</td>
                    <td>
                        <code>@apiKey.AllowedToolGroups</code>
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="@(() => this.OnEditToolGroupsAsync(apiKey))" title="@HNMO.Web.AdminPanel.Properties.Resources.PageHelpHintEdit">@HNMO.Web.Shared.Properties.Resources.Change</button>
                    </td>
                    <td>
                        @if (apiKey.IsDisabled)
                        {
                            <button type="button" class="btn btn-sm btn-success me-1" @onclick="@(() => this.OnSetDisabledAsync(apiKey, false))" title="@HNMO.Web.AdminPanel.Properties.Resources.PageHelpHintEnable">@Resources.Enable</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-warning me-1" @onclick="@(() => this.OnSetDisabledAsync(apiKey, true))" title="@HNMO.Web.AdminPanel.Properties.Resources.PageHelpHintDisable">@Resources.Disable</button>
                        }
                        <button type="button" class="btn btn-sm btn-danger" @onclick="@(() => this.OnDeleteAsync(apiKey))" title="@HNMO.Web.AdminPanel.Properties.Resources.PageHelpHintDelete">@Resources.Delete</button>
                    </td>
                </tr>
            }
            @if (this._apiKeys.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-muted">@Resources.NoApiKeys</td>
                </tr>
            }
            </tbody>
        </table>
        <button type="button" class="btn btn-sm btn-success" @onclick="@this.OnCreateNewAsync" title="@HNMO.Web.AdminPanel.Properties.Resources.PageHelpHintCreate">@Resources.CreateApiKey</button>
    </div>
}
