@page "/teleport-npc"

<PageTitle>@L("Teleport NPC", "NPC Dịch Chuyển")</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div class="d-flex align-items-center gap-2">
        <h3 class="mb-0">@L("Teleport NPC", "NPC Dịch Chuyển")</h3>
        <button type="button"
                class="btn btn-sm btn-outline-info"
                title="@L("Show or hide setup instructions for this page.", "Hiện hoặc ẩn hướng dẫn sử dụng trang này.")"
                @onclick="() => this._showHelp = !this._showHelp">
            ?
        </button>
    </div>
<PageHelp Text="@HNMO.Web.AdminPanel.Properties.Resources.PageHelpTextTeleportNpc" />
    <div class="btn-group btn-group-sm" role="group" aria-label="@L("Language", "Ngôn ngữ")">
        <button type="button" class="btn @(!this._isVi ? "btn-primary" : "btn-outline-secondary")" @onclick="() => this.SetLanguage(false)" title="@HNMO.Web.AdminPanel.Properties.Resources.PageHelpHintLanguageEn">English</button>
        <button type="button" class="btn @(this._isVi ? "btn-primary" : "btn-outline-secondary")" @onclick="() => this.SetLanguage(true)" title="@HNMO.Web.AdminPanel.Properties.Resources.PageHelpHintLanguageVi">Tiếng Việt</button>
    </div>
</div>

@if (this._showHelp)
{
    <div class="alert alert-info mb-3" role="note">
        <strong>@L("How to use this page", "Hướng dẫn sử dụng trang này"):</strong>
        <ul class="mb-0 mt-1">
            <li>@L("Configure which NPC definition numbers open the Teleport NPC menu when clicked (default 247 Crossbow Guard / 540 Lugard, any NPC with NpcWindow.Undefined).", "Chọn danh sách mã NPC mở bảng Dịch chuyển khi người chơi nói chuyện (mặc định 247, 540 hoặc NPC có cửa sổ Undefined).")</li>
            <li>@L("Each destination specifies target map number, (X, Y) coordinates, min/max level, min resets, VIP gate, PK allowance, and Zen fee.", "Mỗi điểm đến quy định mã bản đồ, tọa độ (X, Y), cấp tối thiểu/tối đa, số Reset, điều kiện VIP, PK và phí Zen.")</li>
            <li>@L("TeleportNpcPlugIn is OFF by default until you switch it ON and save.", "TeleportNpcPlugIn mặc định TẮT cho tới khi bạn bật và lưu.")</li>
        </ul>
    </div>
}

@if (this._isLoading)
{
    <p>@L("Loading Teleport NPC configuration...", "Đang tải cấu hình NPC Dịch Chuyển...")</p>
}
else if (this._configuration is { } cfg)
{
    <div class="card mb-3">
        <div class="card-header fw-semibold">@L("General Settings", "Cài Đặt Chung")</div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="tpEnabled"
                               @bind="this._isActive"
                               title="@L("Enable or disable TeleportNpcPlugIn.", "Bật hoặc tắt NPC Dịch Chuyển.")" />
                        <label class="form-check-label" for="tpEnabled">@L("Enable Teleport NPC", "Bật NPC Dịch Chuyển")</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="tpClose"
                               @bind="cfg.CloseAfterWarp"
                               title="@L("Automatically close the Teleport menu after a successful warp.", "Tự động đóng bảng dịch chuyển sau khi dịch chuyển thành công.")" />
                        <label class="form-check-label" for="tpClose">@L("Close After Warp", "Tự Đóng Sau Dịch Chuyển")</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label mb-1" for="tpNpcs"
                           title="@L("Comma-separated NPC definition numbers (e.g. 247, 540).", "Các mã NPC cách nhau bởi dấu phẩy (vd: 247, 540).")">
                        @L("NPC Numbers", "Mã NPC")
                    </label>
                    <input type="text" id="tpNpcs" class="form-control form-control-sm" @bind="this._npcNumbersText" placeholder="247, 540" />
                </div>
                <div class="col-md-3 text-md-end">
                    <button type="button" class="btn btn-primary btn-sm"
                            disabled="@this._isSaving"
                            title="@L("Save Teleport NPC settings and destinations.", "Lưu cài đặt và danh sách điểm đến.")"
                            @onclick="this.SaveAsync">
                        @L("Save Settings", "Lưu Cài Đặt")
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm ms-1"
                            title="@L("Restore starter map destinations.", "Khôi phục danh sách bản đồ mẫu.")"
                            @onclick="this.RestoreDefaults">
                        @L("Defaults", "Mặc Định")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span class="fw-semibold">@L("Destinations", "Điểm Dịch Chuyển") (@cfg.Destinations.Count)</span>
            <button type="button" class="btn btn-sm btn-outline-primary"
                    title="@L("Add a new Teleport NPC destination.", "Thêm điểm dịch chuyển mới.")"
                    @onclick="this.AddDestination">
                + @L("Add Destination", "Thêm Điểm Đến")
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>@L("On", "Bật")</th>
                        <th>@L("Id", "Mã")</th>
                        <th>@L("Name (EN)", "Tên (EN)")</th>
                        <th>@L("Name (VI)", "Tên (VI)")</th>
                        <th>@L("Map", "Bản đồ")</th>
                        <th>X</th>
                        <th>Y</th>
                        <th>@L("Min Lv", "Cấp tối thiểu")</th>
                        <th>@L("Max Lv", "Cấp tối đa")</th>
                        <th>@L("Resets", "Reset")</th>
                        <th>@L("Zen Fee", "Phí Zen")</th>
                        <th>VIP</th>
                        <th>PK</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < cfg.Destinations.Count; i++)
                    {
                        var dest = cfg.Destinations[i];
                        var idx = i;
                        <tr>
                            <td><input type="checkbox" class="form-check-input" @bind="dest.Enabled" /></td>
                            <td><input type="text" class="form-control form-control-sm" style="min-width:85px" @bind="dest.Id" /></td>
                            <td><input type="text" class="form-control form-control-sm" style="min-width:120px" @bind="dest.NameEn" /></td>
                            <td><input type="text" class="form-control form-control-sm" style="min-width:120px" @bind="dest.NameVi" /></td>
                            <td><input type="number" min="0" class="form-control form-control-sm" style="width:68px" @bind="dest.MapNumber" /></td>
                            <td><input type="number" min="0" max="255" class="form-control form-control-sm" style="width:65px" @bind="dest.TargetX" /></td>
                            <td><input type="number" min="0" max="255" class="form-control form-control-sm" style="width:65px" @bind="dest.TargetY" /></td>
                            <td><input type="number" min="0" class="form-control form-control-sm" style="width:68px" @bind="dest.MinLevel" /></td>
                            <td><input type="number" min="0" class="form-control form-control-sm" style="width:68px" @bind="dest.MaxLevel" /></td>
                            <td><input type="number" min="0" class="form-control form-control-sm" style="width:68px" @bind="dest.MinResets" /></td>
                            <td><input type="number" min="0" class="form-control form-control-sm" style="width:92px" @bind="dest.ZenCost" /></td>
                            <td><input type="checkbox" class="form-check-input" @bind="dest.VipOnly" /></td>
                            <td><input type="checkbox" class="form-check-input" @bind="dest.AllowPk" /></td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        title="@L("Remove destination row.", "Xóa điểm đến này.")"
                                        @onclick="() => this.RemoveDestination(idx)">×</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
