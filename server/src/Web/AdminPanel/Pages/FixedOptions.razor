@page "/fixed-options"

<PageTitle>@L("Fixed Item Options", "Cố Định Dòng Trang Bị")</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div class="d-flex align-items-center gap-2">
        <h3 class="mb-0">@L("Fixed Item Options", "Cố Định Dòng Trang Bị")</h3>
        <button type="button"
                class="btn btn-sm btn-outline-info"
                title="@L("Show or hide setup instructions for this page.", "Hiện hoặc ẩn hướng dẫn sử dụng trang này.")"
                @onclick="() => this._showHelp = !this._showHelp">
            ?
        </button>
    </div>
<PageHelp Text="@HNMO.Web.AdminPanel.Properties.Resources.PageHelpTextFixedOptions" />
    <div class="btn-group btn-group-sm" role="group" aria-label="@L("Language", "Ngôn ngữ")">
        <button type="button" class="btn @(!this._isVi ? "btn-primary" : "btn-outline-secondary")" @onclick="() => this.SetLanguage(false)" title="@HNMO.Web.AdminPanel.Properties.Resources.PageHelpHintLanguageEn">English</button>
        <button type="button" class="btn @(this._isVi ? "btn-primary" : "btn-outline-secondary")" @onclick="() => this.SetLanguage(true)" title="@HNMO.Web.AdminPanel.Properties.Resources.PageHelpHintLanguageVi">Tiếng Việt</button>
    </div>
</div>

@if (this._showHelp)
{
    <div class="alert alert-info mb-3" role="note">
        <strong>@L("How to use this page", "Hướng dẫn sử dụng trang này"):</strong>
        <ul class="mb-0 mt-1">
            <li>@L("Pin guaranteed Skill, Luck, minimum upgrade level (+0..+15), minimum additional option (+4..+28 / level 1..7), or Excellent options onto matching items from drops or boxes/events.", "Cố định dòng Kỹ năng (Skill), May mắn (Luck), cấp nâng tối thiểu (+0..+15), dòng Opt tối thiểu (+4..+28) hoặc dòng Hoàn hảo cho vật phẩm rơi ra hoặc mở hộp/sự kiện.")</li>
            <li>@L("Use Group = -1 or Number = -1 as wildcards (e.g. Group 0, Number -1 applies to all Swords). Use Source = 'box_event' to target event chests/mini-game rewards only.", "Dùng Nhóm = -1 hoặc Mã = -1 để khớp tất cả (vd Nhóm 0, Mã -1 áp dụng cho mọi Kiếm). Chọn Nguồn 'box_event' để chỉ áp dụng cho hộp/phần thưởng sự kiện.")</li>
            <li>@L("FixedItemOptionsPlugIn is OFF by default until you turn it ON and save.", "FixedItemOptionsPlugIn mặc định TẮT cho tới khi bạn bật và lưu.")</li>
        </ul>
    </div>
}

@if (this._isLoading)
{
    <p>@L("Loading fixed item options configuration...", "Đang tải cấu hình cố định dòng trang bị...")</p>
}
else if (this._configuration is { } cfg)
{
    <div class="card mb-3">
        <div class="card-header fw-semibold">@L("General Settings", "Cài Đặt Chung")</div>
        <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="fioEnabled"
                       @bind="this._isActive"
                       title="@L("Enable or disable FixedItemOptionsPlugIn on this server.", "Bật hoặc tắt cố định dòng trang bị trên máy chủ này.")" />
                <label class="form-check-label" for="fioEnabled">@L("Enable Fixed Item Options", "Bật Cố Định Dòng Trang Bị")</label>
            </div>
            <div>
                <button type="button" class="btn btn-primary btn-sm"
                        disabled="@this._isSaving"
                        title="@L("Save fixed item option rules.", "Lưu danh sách quy tắc cố định dòng.")"
                        @onclick="this.SaveAsync">
                    @L("Save Settings", "Lưu Cài Đặt")
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm ms-1"
                        title="@L("Restore starter rule examples.", "Khôi phục quy tắc mẫu.")"
                        @onclick="this.RestoreDefaults">
                    @L("Defaults", "Mặc Định")
                </button>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span class="fw-semibold">@L("Item Option Pin Rules", "Quy Tắc Cố Định Dòng") (@cfg.Rules.Count)</span>
            <button type="button" class="btn btn-sm btn-outline-primary"
                    title="@L("Add a new fixed item option rule.", "Thêm quy tắc cố định dòng mới.")"
                    @onclick="this.AddRule">
                + @L("Add Rule", "Thêm Quy Tắc")
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>@L("On", "Bật")</th>
                        <th>@L("Label", "Tên Gợi Nhớ")</th>
                        <th title="@L("Item Group (-1 = any group).", "Nhóm vật phẩm (-1 = tất cả).")">@L("Group", "Nhóm")</th>
                        <th title="@L("Item Number (-1 = any item in group).", "Mã vật phẩm (-1 = tất cả trong nhóm).")">@L("Number", "Mã")</th>
                        <th title="@L("all = drops + boxes/events; drop = monsters only; box_event = event chests/mini-games.", "all = tất cả; drop = quái rơi; box_event = hộp/sự kiện.")">@L("Source", "Nguồn")</th>
                        <th title="@L("Map Number (-1 = any map).", "Mã bản đồ (-1 = tất cả).")">@L("Map", "Bản đồ")</th>
                        <th>@L("Skill", "Skill")</th>
                        <th>@L("Luck", "Luck")</th>
                        <th title="@L("Minimum upgrade level (+0..+15).", "Cấp nâng tối thiểu (+0..+15).")">@L("Min Lv", "Cấp")</th>
                        <th title="@L("Minimum Life/Damage Option level (1..7 = +4..+28).", "Dòng Opt tối thiểu (1..7 = +4..+28).")">@L("Min Opt", "Opt")</th>
                        <th title="@L("Minimum Excellent options guaranteed (0..6).", "Số dòng Hoàn hảo tối thiểu (0..6).")">@L("Min Exc", "Số Exc")</th>
                        <th title="@L("Optional bitmask of specific Excellent option numbers (0 = auto).", "Bitmask dòng Exc cụ thể (0 = tự động).")">@L("Exc Bits", "Bit Exc")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < cfg.Rules.Count; i++)
                    {
                        var rule = cfg.Rules[i];
                        var idx = i;
                        <tr>
                            <td><input type="checkbox" class="form-check-input" @bind="rule.Enabled" /></td>
                            <td><input type="text" class="form-control form-control-sm" style="min-width:150px" @bind="rule.Label" /></td>
                            <td><input type="number" min="-1" max="15" class="form-control form-control-sm" style="width:68px" @bind="rule.ItemGroup" /></td>
                            <td><input type="number" min="-1" max="511" class="form-control form-control-sm" style="width:72px" @bind="rule.ItemNumber" /></td>
                            <td>
                                <select class="form-select form-select-sm" style="min-width:105px" @bind="rule.SourceFilter">
                                    <option value="all">@L("All", "Tất cả")</option>
                                    <option value="drop">@L("Drops", "Quái rơi")</option>
                                    <option value="box_event">@L("Box / Event", "Hộp / Sự kiện")</option>
                                </select>
                            </td>
                            <td><input type="number" min="-1" class="form-control form-control-sm" style="width:68px" @bind="rule.MapNumber" /></td>
                            <td><input type="checkbox" class="form-check-input" @bind="rule.PinSkill" /></td>
                            <td><input type="checkbox" class="form-check-input" @bind="rule.PinLuck" /></td>
                            <td><input type="number" min="0" max="15" class="form-control form-control-sm" style="width:65px" @bind="rule.MinLevel" /></td>
                            <td><input type="number" min="0" max="7" class="form-control form-control-sm" style="width:65px" @bind="rule.MinOptionLevel" /></td>
                            <td><input type="number" min="0" max="6" class="form-control form-control-sm" style="width:65px" @bind="rule.MinExcellentCount" /></td>
                            <td><input type="number" min="0" max="63" class="form-control form-control-sm" style="width:70px" @bind="rule.ForcedExcellentBits" /></td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        title="@L("Remove this rule.", "Xóa quy tắc này.")"
                                        @onclick="() => this.RemoveRule(idx)">×</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
