@page "/bug-reports"
@attribute [Authorize(Policy = AdminPolicies.Administrator)]

@using HNMO.GameLogic.PlugIns.BugReports
@using HNMO.Web.AdminPanel.Properties

<PageTitle>HNMO: @L("Bug reports", "Báo lỗi")</PageTitle>
<Breadcrumb IsFirstFromRoot="true" Caption="@L("Bug reports", "Báo lỗi")" />
<h1>@L("Bug reports", "Báo lỗi")</h1>
<PageHelp Text="@HNMO.Web.AdminPanel.Properties.Resources.PageHelpTextBugReports" />

@if (this._isLoading)
{
    <p>@Resources.Loading</p>
}
else
{
    @if (!this._active)
    {
        <div class="alert alert-secondary" role="status">@L("Bug reports are off: switch on \"HNMO bug reports\" in Plugins.", "Báo lỗi đang tắt: bật \"Báo lỗi HNMO\" trong Plugins.")</div>
    }

    <ul class="nav nav-tabs mb-3" id="bug-tabs">
        <li class="nav-item"><button type="button" class="nav-link @(this._tab == "players" ? "active" : string.Empty)" id="bug-tab-players" title="@L4("The reports players wrote in the 🐞 window", "Báo lỗi người chơi viết trong cửa sổ 🐞", "Meldungen, die Spieler im 🐞-Fenster geschrieben haben", "玩家在 🐞 窗口中写的报告")" @onclick="@(() => this._tab = "players")">@L4("Players' reports", "Người chơi báo", "Meldungen der Spieler", "玩家报告")</button></li>
        <li class="nav-item"><button type="button" class="nav-link @(this._tab == "auto" ? "active" : string.Empty)" id="bug-tab-auto" title="@L4("Errors the web game sent on its own, grouped by error", "Lỗi game web tự gửi, gộp theo lỗi", "Fehler, die das Webspiel selbst gemeldet hat, nach Fehler gruppiert", "网页游戏自动发送的错误，按错误分组")" @onclick="@(() => this._tab = "auto")">@L4("Automatic", "Tự động", "Automatisch", "自动")<span class="badge bg-secondary ms-1">@this._autoGroups.Count(g => g.Status == AutoErrorStatus.Open)</span></button></li>
    </ul>

    @if (this._tab == "auto")
    {
        <p class="text-muted" id="auto-help">@L4(
            "Errors the players' web game met and sent on its own: grouped by error, most first. They come to you only; you choose what goes on to the HNMO developer (without logins or IPs).",
            "Lỗi mà game web của người chơi gặp và tự gửi: gộp theo lỗi, nhiều nhất lên đầu. Chỉ gửi cho bạn; bạn chọn lỗi nào gửi tiếp cho nhà phát triển HNMO (không có tài khoản hay IP).",
            "Fehler, die das Webspiel der Spieler selbst gemeldet hat: nach Fehler gruppiert, die häufigsten zuerst. Sie gehen nur an dich; du entscheidest, was an den HNMO-Entwickler geht (ohne Logins oder IPs).",
            "玩家网页游戏遇到并自动发送的错误：按错误分组，最多的在前。只发给你；由你决定哪些转发给 HNMO 开发者（不含账号或 IP）。")</p>

        <div class="d-flex flex-wrap gap-3 align-items-center mb-3 border rounded p-2" id="auto-settings">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="auto-on" @bind="this._autoOn" />
                <label class="form-check-label" for="auto-on">@L4("Keep automatic reports", "Nhận báo lỗi tự động", "Automatische Meldungen annehmen", "接收自动报告")</label>
            </div>
            <label for="auto-cap-account">@L4("Per account a day", "Mỗi tài khoản một ngày", "Pro Konto und Tag", "每个账号每天")</label>
            <input type="number" min="0" class="form-control form-control-sm" style="max-width: 6rem" id="auto-cap-account" @bind="this._autoCapAccount" />
            <label for="auto-cap-server">@L4("Server a day", "Cả server một ngày", "Server pro Tag", "服务器每天")</label>
            <input type="number" min="0" class="form-control form-control-sm" style="max-width: 7rem" id="auto-cap-server" @bind="this._autoCapServer" />
            <span class="text-muted small">@L4("(Sydney days)", "(theo ngày Sydney)", "(Tage in Sydney)", "（按悉尼日期）")</span>
            <button type="button" class="btn btn-sm btn-primary ms-auto" id="auto-save" title="@L4("Save the automatic report settings", "Lưu cài đặt báo lỗi tự động", "Einstellungen der automatischen Meldungen speichern", "保存自动报告设置")" disabled="@this._saving" @onclick="this.SaveAutoSettingsAsync">@L4("Save", "Lưu", "Speichern", "保存")</button>
        </div>

        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            <label for="auto-filter">@L4("Show", "Hiện", "Anzeigen", "显示")</label>
            <select id="auto-filter" class="form-select form-select-sm" style="max-width: 12rem" @bind="this._autoFilter">
                <option value="open">@L4("Open", "Đang mở", "Offen", "未处理")</option>
                <option value="all">@L4("All", "Tất cả", "Alle", "全部")</option>
                <option value="Fixed">@L4("Fixed", "Đã sửa", "Behoben", "已修复")</option>
                <option value="Ignored">@L4("Ignored", "Bỏ qua", "Ignoriert", "已忽略")</option>
            </select>
        </div>

        var groups = this.AutoShown().ToList();
        @if (groups.Count == 0)
        {
            <p class="text-muted" id="auto-none">@L4("No automatic error reports here.", "Không có báo lỗi tự động nào ở đây.", "Hier gibt es keine automatischen Fehlermeldungen.", "这里没有自动错误报告。")</p>
        }
        else
        {
            <table class="table table-sm align-middle" id="auto-table">
                <thead>
                    <tr>
                        <th>@L4("Error", "Lỗi", "Fehler", "错误")</th>
                        <th class="text-end">@L4("Reports", "Số lần", "Meldungen", "次数")</th>
                        <th class="text-end">@L4("Accounts", "Tài khoản", "Konten", "账号数")</th>
                        <th>@L4("First / last (Sydney)", "Lần đầu / cuối (Sydney)", "Zuerst / zuletzt (Sydney)", "首次 / 最近（悉尼）")</th>
                        <th>@L4("Versions", "Phiên bản", "Versionen", "版本")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in groups)
                    {
                        <tr class="auto-group" data-id="@g.Id">
                            <td style="max-width: 32rem">
                                <strong>@g.Id</strong> <span class="badge bg-secondary">@g.Kind</span> <span class="badge @AutoStatusClass(g)">@AutoStatusLabel(g)</span>
                                @if (g.QueuedUtc is not null)
                                {
                                    <span class="badge bg-info text-dark">@(g.ForwardedUtc is null ? L4("goes with the weekly report", "sẽ gửi cùng báo cáo tuần", "geht mit dem Wochenbericht", "随周报发送") : L4("sent to the developer", "đã gửi nhà phát triển", "an den Entwickler gesendet", "已发给开发者"))</span>
                                }
                                <div class="small text-break auto-message">@g.Message</div>
                                <details class="small">
                                    <summary>@L4("Details", "Chi tiết", "Details", "详情") (@g.Samples.Count)</summary>
                                    <div class="text-muted">@L4("Fingerprint", "Dấu vết", "Fingerabdruck", "指纹"): <code class="auto-fingerprint">@g.Fingerprint</code></div>
                                    @foreach (var s in g.Samples.AsEnumerable().Reverse())
                                    {
                                        <div class="border-top pt-1 mt-1">
                                            <div>@BugReportsPlugIn.SydneyText(s.ReceivedUtc) · @s.Version · @s.Browser · @s.Os</div>
                                        </div>
                                    }
                                </details>
                            </td>
                            <td class="text-end auto-count">@g.Count</td>
                            <td class="text-end auto-accounts">@g.Accounts.Count</td>
                            <td class="small">@BugReportsPlugIn.SydneyText(g.FirstSeenUtc)<br />@BugReportsPlugIn.SydneyText(g.LastSeenUtc)</td>
                            <td class="small">@string.Join(", ", g.Versions)</td>
                            <td>
                                <div class="d-flex flex-wrap gap-1 justify-content-end">
                                    @if (g.Status != AutoErrorStatus.Fixed)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success auto-fixed" title="@L4("A new report of it opens it again.", "Nếu lỗi gặp lại, nó sẽ mở lại.", "Eine neue Meldung öffnet ihn wieder.", "再次出现时会重新打开。")" @onclick="() => this.SetAutoStatusAsync(g.Id, AutoErrorStatus.Fixed)">@L4("Mark fixed", "Đánh dấu đã sửa", "Als behoben markieren", "标记为已修复")</button>
                                    }
                                    @if (g.Status != AutoErrorStatus.Ignored)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary auto-ignore" title="@L4("Still counted, without new samples.", "Vẫn đếm, không giữ mẫu mới.", "Wird weiter gezählt, ohne neue Beispiele.", "仍计数，但不再保存新样本。")" @onclick="() => this.SetAutoStatusAsync(g.Id, AutoErrorStatus.Ignored)">@L4("Ignore", "Bỏ qua", "Ignorieren", "忽略")</button>
                                    }
                                    @if (g.Status != AutoErrorStatus.Open)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-warning auto-open" title="@L4("Show it among the open errors again", "Đưa lại vào danh sách lỗi đang mở", "Wieder zu den offenen Fehlern", "重新放回未处理错误")" @onclick="() => this.SetAutoStatusAsync(g.Id, AutoErrorStatus.Open)">@L4("Reopen", "Mở lại", "Wieder öffnen", "重新打开")</button>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-primary auto-forward" disabled="@(!HNMO.GameLogic.DeveloperHub.CanForwardAutomaticErrors || g.QueuedUtc is not null)"
                                            title="@L4("Send it to the HNMO developer with this server's weekly report (no login or IP).", "Gửi cho nhà phát triển HNMO cùng báo cáo tuần của server (không có tài khoản hay IP).", "Mit dem Wochenbericht dieses Servers an den HNMO-Entwickler senden (ohne Login oder IP).", "随本服务器的周报发给 HNMO 开发者（不含账号或 IP）。")"
                                            @onclick="() => this.ForwardAutoAsync(g.Id)">@L4("Forward to developer", "Gửi nhà phát triển", "An Entwickler senden", "转发给开发者")</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
    else
    {
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3" id="bug-filter">
        <label for="bug-status">@L("Show", "Hiện")</label>
        <select id="bug-status" class="form-select form-select-sm" style="max-width: 14rem" @bind="this._filter">
            <option value="open">@L("New and confirmed", "Mới và đã xác nhận")</option>
            <option value="all">@L("All", "Tất cả")</option>
            @foreach (var s in Enum.GetValues<BugReportStatus>())
            {
                <option value="@s">@StatusLabel(s)</option>
            }
        </select>
        <span class="ms-2 text-muted">@L($"Reward for a confirmed bug: {this.RewardText}", $"Thưởng cho lỗi được xác nhận: {this.RewardText}")</span>
        <span class="ms-2 text-muted">@(this._canForward ? L("Sending to the HNMO developer: on", "Gửi tới nhà phát triển HNMO: bật") : L("Sending to the HNMO developer: off", "Gửi tới nhà phát triển HNMO: tắt"))</span>
    </div>

    var shown = this.Shown().ToList();
    @if (shown.Count == 0)
    {
        <p class="text-muted" id="bug-none">@L("No bug reports here.", "Không có báo lỗi nào ở đây.")</p>
    }

    @foreach (var r in shown)
    {
        <section class="card mb-3 bug-report" data-id="@r.Id">
            <div class="card-body">
                <p class="mb-1">
                    <strong>@r.Id</strong> · <span class="badge bg-secondary">@CategoryLabel(r.Category)</span> · <span class="badge @StatusClass(r.Status)">@StatusLabel(r.Status)</span>
                    @if (r.Status == BugReportStatus.Duplicate)
                    {
                        <span> @L("of", "của") @r.DuplicateOf</span>
                    }
                    · @BugReportsPlugIn.SydneyText(r.CreatedUtc) · @r.Login / @r.Character · @r.Server · @r.Place
                    @if (r.RewardGiven > 0)
                    {
                        <span> · @L($"rewarded {r.RewardGiven}", $"đã thưởng {r.RewardGiven}")</span>
                    }
                    @if (r.ForwardedUtc is { } fw)
                    {
                        <span> · @L("sent to the developer", "đã gửi nhà phát triển") @BugReportsPlugIn.SydneyText(fw)</span>
                    }
                    else if (r.QueuedUtc is not null)
                    {
                        <span class="bug-queued"> · @L("goes to the developer with the weekly report", "sẽ gửi nhà phát triển cùng báo cáo hằng tuần")</span>
                    }
                </p>
                <p class="mb-2 bug-text" style="white-space: pre-wrap">@r.Text</p>
                @if (r.Info.Length > 0)
                {
                    <details class="mb-2"><summary>@L("Details the game added", "Chi tiết game tự thêm")</summary><pre class="small mb-0">@r.Info</pre></details>
                }
                @if (!string.IsNullOrWhiteSpace(r.Reply))
                {
                    <p class="mb-2"><em>@L("Your answer:", "Bạn đã trả lời:")</em> @r.Reply</p>
                }
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-success" title="@L("It's a real bug (gives the reward, if one is set).", "Đúng là lỗi (trao thưởng, nếu có).")" @onclick="() => this.SetStatusAsync(r.Id, BugReportStatus.Confirmed)">@L("Confirm", "Xác nhận")</button>
                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => this.SetStatusAsync(r.Id, BugReportStatus.Fixed)">@L("Fixed", "Đã sửa")</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => this.SetStatusAsync(r.Id, BugReportStatus.NotABug)">@L("Not a bug", "Không phải lỗi")</button>
                    <input class="form-control form-control-sm" style="max-width: 7rem" placeholder="@L("e.g. B3", "vd. B3")" @bind="this._duplicateOf[r.Id]" />
                    <button type="button" class="btn btn-sm btn-outline-secondary" title="@L("The same bug as the report named on the left.", "Cùng lỗi với báo lỗi ghi bên trái.")" @onclick="() => this.SetStatusAsync(r.Id, BugReportStatus.Duplicate)">@L("Duplicate", "Trùng")</button>
                    <button type="button" class="btn btn-sm btn-outline-primary ms-auto bug-forward" disabled="@(!this._canForward || r.QueuedUtc is not null)"
                            title="@L("Send this report to the HNMO developer with this server's weekly report (no login, e-mail or IP).", "Gửi báo lỗi này tới nhà phát triển HNMO cùng báo cáo hằng tuần của server (không có tài khoản, email hay IP).")"
                            @onclick="() => this.ForwardAsync(r.Id)">@L("Send to the HNMO developer", "Gửi cho nhà phát triển HNMO")</button>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <input class="form-control form-control-sm bug-reply" placeholder="@L("Answer the player (they see it in the game)", "Trả lời người chơi (họ thấy trong game)")" @bind="this._replies[r.Id]" />
                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => this.ReplyAsync(r.Id)">@L("Answer", "Trả lời")</button>
                </div>
            </div>
        </section>
    }
    }
}
