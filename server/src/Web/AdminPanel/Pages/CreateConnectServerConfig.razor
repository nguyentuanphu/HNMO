@using HelpResources = HNMO.Web.AdminPanel.Properties.Resources
@page "/create-connect-server"
@attribute [Authorize(Policy = AdminPolicies.Administrator)]

@using HNMO.Web.AdminPanel.Properties
@{
  var title = Resources.CreateConnectServer;
}
<PageTitle>HNMO: @title</PageTitle>
<Breadcrumb Caption="@title"/>
<h1>@title</h1>
<PageHelp Text="@HelpResources.PageHelpTextCreateConnectServerConfig" />



@if (this._viewModel is null)
{
    return;
}

<AutoForm Model="this._viewModel" OnValidSubmit="this.OnSaveButtonClickAsync" IsProcessing="this._isProcessing"></AutoForm>

