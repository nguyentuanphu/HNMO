@page "/state-retention"
@attribute [Authorize(Policy = AdminPolicies.Administrator)]

@using HNMO.GameLogic.PlugIns
@using HNMO.Web.AdminPanel.Properties

<PageTitle>HNMO: @L("Player state & archival", "Lưu trữ & Dọn dữ liệu")</PageTitle>
<Breadcrumb IsFirstFromRoot="true" Caption="@L("Player state & archival", "Lưu trữ & Dọn dữ liệu")" />
<div class="d-flex align-items-center gap-2 mb-2">
    <h1 class="mb-0">@L("Player state & archival", "Lưu trữ & Dọn dữ liệu")</h1>
    <button type="button" class="btn btn-sm btn-outline-info" title="@L("How to use this page", "Hướng dẫn sử dụng trang này")" @onclick="() => this._showHelp = !this._showHelp">?</button>
</div>
<PageHelp Text="@HNMO.Web.AdminPanel.Properties.Resources.PageHelpTextStateRetention" />
<p class="text-muted">@L("Per-account and per-character plug-in state is stored in PostgreSQL rows (hnmo.player_feature_state) and updated individually. Finished race/season rows and expired gift-code claims are archived automatically after N days.", "Dữ liệu tài khoản/nhân vật của các tính năng được lưu từng dòng riêng trong PostgreSQL (hnmo.player_feature_state). Dữ liệu mùa/đua top đã kết thúc và giftcode hết hạn sẽ tự động chuyển lưu trữ sau N ngày.")</p>

@if (this._showHelp)
{
    <div class="alert alert-info" role="region" id="state-retention-help">
        <strong>@L("How to use this page:", "Hướng dẫn:")</strong>
        <ul class="mb-0 mt-1">
            <li>@L("Large per-player dictionaries from save/hnmo-state.json are migrated automatically into PostgreSQL rows on first start.", "Các dữ liệu lớn trong save/hnmo-state.json tự động di chuyển sang từng dòng PostgreSQL ở lần khởi động đầu tiên.")</li>
            <li>@L("Only small server-wide counters remain in save/hnmo-state.json.", "Chỉ giữ các thông số toàn máy chủ nhỏ gọn trong save/hnmo-state.json.")</li>
            <li>@L("Set how many days finished seasons, races, and expired gift-code claims stay active before moving to the archive table.", "Chọn số ngày giữ lại dữ liệu đã kết thúc trước khi chuyển sang bảng lưu trữ.")</li>
        </ul>
    </div>
}

@if (this._isLoading)
{
    <p>@Resources.Loading</p>
}
else if (this._configuration is { } c)
{
    <section class="card mb-3" id="sr-settings">
        <div class="card-body">
            <div class="row g-2 mb-3">
                <div class="col-sm-4">
                    <label class="form-label" for="sr-days" title="@L("Days after race end or code expiry before archival", "Số ngày sau khi kết thúc mùa/mã trước khi chuyển lưu trữ")">@L("Archive finished data after (days)", "Lưu trữ dữ liệu cũ sau (ngày)")</label>
                    <input class="form-control" id="sr-days" type="number" min="1" max="3650" @bind="c.ArchiveFinishedDataAfterDays" />
                </div>
                <div class="col-sm-4">
                    <label class="form-label" for="sr-file">@L("State key", "Khóa lưu trữ")</label>
                    <input class="form-control" id="sr-file" @bind="c.FileName" />
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary" id="sr-save" disabled="@this._isSaving" @onclick="this.SaveAsync" title="@HNMO.Web.AdminPanel.Properties.Resources.PageHelpHintSave">@Resources.Save</button>
                <button type="button" class="btn btn-outline-warning" id="sr-archive" disabled="@this._isSaving" @onclick="this.ArchiveNowAsync" title="@HNMO.Web.AdminPanel.Properties.Resources.PageHelpHintSave">@L("Archive expired rows now", "Chuyển lưu trữ ngay")</button>
            </div>
        </div>
    </section>

    <section class="card" id="sr-stats">
        <div class="card-body">
            <h2 class="h5">@L("Storage summary (Sydney time)", "Thống kê lưu trữ (Giờ Sydney)")</h2>
            <p class="mb-1">@L($"Active DB rows: {this._activeRows}", $"Số dòng đang hoạt động: {this._activeRows}")</p>
            <p class="mb-1">@L($"Archived DB rows: {this._archivedRows}", $"Số dòng đã chuyển lưu trữ: {this._archivedRows}")</p>
            <p class="mb-0 text-muted">@(this._meta.LastArchivedAtUtc is { } at ? L($"Last archival: {SydneyTime(at)} ({this._meta.LastArchivedCount} moved)", $"Lần dọn gần nhất: {SydneyTime(at)} ({this._meta.LastArchivedCount} dòng)") : L("No archival run recorded yet.", "Chưa có lần chuyển lưu trữ nào."))</p>
        </div>
    </section>
}
