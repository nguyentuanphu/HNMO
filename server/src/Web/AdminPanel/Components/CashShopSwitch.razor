@* The cash shop's on/off switch of this season (owner 2026-11-28): a host may run a classic season, without pay to win. *@
@using System.Globalization
@using HNMO.GameLogic.CashShop
@using HNMO.Interfaces
@using HNMO.Persistence
@using HNMO.Web.AdminPanel.API
@using HNMO.Web.AdminPanel.Operations
@using HNMO.Web.Shared.Components.Toast
@using Microsoft.Extensions.Logging
@inject IPersistenceContextProvider PersistenceContextProvider
@inject PluginWriteOperations PluginOperations
@inject IToastService ToastService
@inject ILogger<CashShopSwitch> Logger

<section class="card mb-3" id="cash-shop-switch">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center gap-3">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="cash-shop-enabled" checked="@this._enabled" disabled="@(this._loading || this._saving)" @onchange="this.OnChangedAsync" />
                <label class="form-check-label fw-semibold" for="cash-shop-enabled">@L4($"Cash shop of {this.SeasonName}", $"Cash shop của {this.SeasonName}", $"Cash Shop von {this.SeasonName}", $"{this.SeasonName} 的商城")</label>
            </div>
            <span class="badge @(this._enabled ? "bg-success" : "bg-secondary")" id="cash-shop-state">@(this._enabled ? L4("On", "Bật", "An", "开") : L4("Off: classic", "Tắt: classic", "Aus: klassisch", "关：经典"))</span>
        </div>
        <p class="small text-muted mt-2 mb-0" id="cash-shop-note">
            @L4(
                "Off = a classic season without pay to win: the cash shop doesn't open in the game (its button and the X key do nothing, its entry in the phone menu is hidden); players can't buy items with W Coin or Goblin Points; the game gives no free coins any more (missions, world bosses, the new-player guide, community, guild levels, lucky number, top races, events, the mailbox, Goblin Points for play time, VIP's daily coins) and its windows don't show coin rewards. Gift codes, top-ups and coins traded between players stay. Items already bought stay. W Coin can still buy VIP (the VIP window and the website's account page); for fully classic play turn VIP off too (VIP page). This switch is for this season only: Season 6.3 and Season 9 each have their own. Players in the game see it after they enter the game again.",
                "Tắt = season kiểu classic, không pay to win: cash shop không mở được trong game (nút của nó và phím X không làm gì, mục trong menu điện thoại bị ẩn); người chơi không mua được vật phẩm bằng W Coin hay Goblin Point; game không cho coin miễn phí nữa (nhiệm vụ, boss thế giới, hướng dẫn tân thủ, cộng đồng, cấp bang hội, số may mắn, đua top, sự kiện, hộp thư, Goblin Point theo giờ chơi, coin hằng ngày của VIP) và các cửa sổ không hiện phần thưởng coin. Gift code, nạp tiền và coin người chơi trao cho nhau vẫn giữ. Vật phẩm đã mua vẫn giữ. W Coin vẫn mua được VIP (cửa sổ VIP và trang tài khoản trên website); muốn classic hoàn toàn thì tắt luôn VIP (trang VIP). Công tắc này chỉ cho season này: Season 6.3 và Season 9 có công tắc riêng. Người chơi đang trong game thấy thay đổi khi vào lại game.",
                "Aus = eine klassische Season ohne Pay-to-win: der Cash Shop öffnet sich im Spiel nicht (sein Knopf und die Taste X tun nichts, sein Eintrag im Handy-Menü ist ausgeblendet); Spieler können keine Gegenstände mit W Coin oder Goblin Points kaufen; das Spiel vergibt keine Gratis-Coins mehr (Missionen, Weltbosse, Einsteigerführung, Community, Gildenstufen, Glückszahl, Top-Rennen, Events, Postfach, Goblin Points für Spielzeit, tägliche VIP-Coins), und seine Fenster zeigen keine Coin-Belohnungen. Geschenkcodes, Aufladungen und zwischen Spielern gehandelte Coins bleiben. Gekaufte Gegenstände bleiben. W Coin kauft weiter VIP (VIP-Fenster und Kontoseite der Website); für ganz klassisches Spiel auch VIP ausschalten (VIP-Seite). Gilt nur für diese Season: Season 6.3 und Season 9 haben je einen eigenen Schalter. Spieler im Spiel sehen es nach dem nächsten Betreten.",
                "关 = 无氪金的经典赛季：游戏内商城无法打开（其按钮和 X 键无反应，手机菜单中的入口隐藏）；玩家不能用 W Coin 或 Goblin Point 购买物品；游戏不再发放免费币（任务、世界首领、新手引导、社区、公会等级、幸运数字、排行竞赛、活动、邮箱、按游戏时间的 Goblin Point、VIP 每日币），各窗口也不再显示币奖励。礼包码、充值以及玩家之间交易的币保持不变。已购买的物品保留。W Coin 仍可购买 VIP（VIP 窗口和网站账号页）；若要完全经典，请同时关闭 VIP（VIP 页面）。此开关只作用于本赛季：Season 6.3 与 Season 9 各有各的开关。游戏中的玩家重新进入游戏后生效。")
        </p>
    </div>
</section>

@code {
    private bool _enabled;
    private bool _loading = true;
    private bool _saving;

    private string SeasonName => HnmoSeasonInstance.Current switch
    {
        HnmoSeasonInstance.SeasonNine => "Season 9",
        HnmoSeasonInstance.Arena => "Arena",
        _ => "Season 6.3",
    };

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var (_, active, _) = await PlugInSettings.ReadStoredAsync<CashShopSettings>(this.PersistenceContextProvider, typeof(CashShopFeaturePlugIn), default).ConfigureAwait(true);
            this._enabled = active;
        }
        catch (Exception ex)
        {
            this.Logger.LogError(ex, "The cash shop switch couldn't be read.");
        }
        finally
        {
            this._loading = false;
        }
    }

    private static string L4(string en, string vi, string de, string zh) =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName switch
        {
            "vi" => vi,
            "de" => de,
            "zh" => zh,
            _ => en,
        };

    private async Task OnChangedAsync(ChangeEventArgs args)
    {
        var enable = args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        this._saving = true;
        try
        {
            var id = typeof(CashShopFeaturePlugIn).GUID;
            var preview = await this.PluginOperations.SetActiveAsync(id, enable, false, null, default).ConfigureAwait(true);
            if (preview["confirmationToken"]?.GetValue<string>() is { } token)
            {
                await this.PluginOperations.SetActiveAsync(id, enable, true, token, default).ConfigureAwait(true);
            }

            this._enabled = enable;
            this.ToastService.ShowSuccess(enable
                ? L4("The cash shop is on.", "Đã bật cash shop.", "Der Cash Shop ist an.", "商城已开启。")
                : L4("The cash shop is off: classic play.", "Đã tắt cash shop: chơi kiểu classic.", "Der Cash Shop ist aus: klassisches Spiel.", "商城已关闭：经典玩法。"));
        }
        catch (Exception ex)
        {
            this.Logger.LogError(ex, "The cash shop switch couldn't be saved.");
            this.ToastService.ShowError(ex.Message);
        }
        finally
        {
            this._saving = false;
        }
    }
}
