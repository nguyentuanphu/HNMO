@* The home page's big buttons (seasons plan, step 2): Season 6.3 and Season 9 side by side, plus the shared settings. *@
@using HNMO.Interfaces
@using HNMO.Web.AdminPanel.Properties
@using HNMO.Web.AdminPanel.Services
@inject IServiceProvider Services
@inject NavigationManager Navigation

<section class="season-chooser" aria-label="@Resources.SeasonChooserTitle">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
        <h2 class="season-chooser-title mb-0">@Resources.SeasonChooserTitle</h2>
        <a class="btn btn-sm btn-outline-primary" id="season-manage-link" href="seasons">@Resources.SeasonsManageLink</a>
    </div>
    <div class="season-chooser-grid">
        @foreach (var panel in this._panels)
        {
            var title = panel.Season switch { HnmoSeasonInstance.SeasonNine => Resources.SeasonNineButton, HnmoSeasonInstance.Arena => Resources.ArenaButton, _ => Resources.SeasonSixButton };
            var hint = panel.Season switch { HnmoSeasonInstance.SeasonNine => Resources.SeasonNineButtonHint, HnmoSeasonInstance.Arena => Resources.ArenaButtonHint, _ => Resources.SeasonSixButtonHint };
            if (panel.Url is null)
            {
                <div class="season-button season-@panel.Season is-off" id="season-button-@panel.Season" aria-disabled="true">
                    <span class="season-button-name">@title</span>
                    <span class="season-button-hint">@(panel.Season == HnmoSeasonInstance.Arena ? Resources.ArenaOff : Resources.SeasonNineOff)</span>
                </div>
            }
            else
            {
                <a class="season-button season-@panel.Season @(panel.IsCurrent ? "is-current" : null)" id="season-button-@panel.Season" href="@(panel.IsCurrent ? "#season-pages" : panel.Url)">
                    <span class="season-button-name">@title</span>
                    <span class="season-button-hint">@hint</span>
                    @if (panel.IsCurrent)
                    {
                        <span class="season-button-here">@Resources.SeasonYouAreHere</span>
                    }
                </a>
            }
        }
        <a class="season-button season-shared" id="season-button-shared" href="@SeasonPanels.SharedSettingsUrl(this._panels)">
            <span class="season-button-name">@Resources.SharedSettingsButton</span>
            <span class="season-button-hint">@Resources.SharedSettingsButtonHint</span>
        </a>
    </div>
</section>

@code {
    private IReadOnlyList<SeasonPanel> _panels = [];

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        var uri = new Uri(this.Navigation.Uri);
        // Host settings may be missing (a panel without the host's settings service, e.g. in tests): the defaults then.
        HostSettings settings;
        try
        {
            settings = (this.Services.GetService(typeof(IHostSettingsService)) as IHostSettingsService)?.Load() ?? new HostSettings();
        }
        catch (Exception ex) when (ex is System.IO.IOException or UnauthorizedAccessException or System.Text.Json.JsonException)
        {
            settings = new HostSettings();
        }

        // Through the website's admin path the panels are under one path; on the host computer, on their ports.
        this._panels = new Uri(this.Navigation.BaseUri).AbsolutePath.Length > 1
            ? SeasonPanels.ForWebsite(HnmoSeasonInstance.Current, settings, this.Navigation.BaseUri)
            : SeasonPanels.For(HnmoSeasonInstance.Current, settings, uri.Scheme, uri.Host);
    }
}
