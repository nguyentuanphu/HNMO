@using HNMO.Web.AdminPanel.Properties
@using HNMO.Web.AdminPanel.Services

<nav class="hn-sidebar">
    <div class="top-row navbar navbar-dark">
        <NavLink class="navbar-brand hn-brand" href="" Match="NavLinkMatch.All" @onclick="() => NavigationHistory.Clear()">
            <span class="hn-brand__mark" aria-hidden="true">H</span>
            <span class="hn-brand__text">HNMO <small>@Resources.NavAdmin</small></span>
        </NavLink>
        <button class="navbar-toggler" aria-label="@Resources.NavToggleMenu" aria-expanded="@(this._collapseNavMenu ? "false" : "true")" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>

    <!-- Hiding it programmatically is not a good idea here, because we want to hide it based on the width of the device/window. -->
    <div class="nav-scrollable @NavMenuCssClass">
        <div class="hn-nav-mode" role="group" aria-label="@L("Pages shown in the menu", "Trang hiện trong menu")">
            <button type="button"
                    id="nav-mode-basic"
                    class="hn-nav-mode__option@(this.Preferences.AdvancedMode ? string.Empty : " is-on")"
                    aria-pressed="@(this.Preferences.AdvancedMode ? "false" : "true")"
                    title="@L("Only the pages used every day.", "Chỉ các trang dùng hằng ngày.")"
                    @onclick="() => this.Preferences.SetAdvancedMode(false)">
                @L("Basic", "Cơ bản")
            </button>
            <button type="button"
                    id="nav-mode-advanced"
                    class="hn-nav-mode__option@(this.Preferences.AdvancedMode ? " is-on" : string.Empty)"
                    aria-pressed="@(this.Preferences.AdvancedMode ? "true" : "false")"
                    title="@L("Every page, including the data editors.", "Mọi trang, gồm cả các bảng dữ liệu.")"
                    @onclick="() => this.Preferences.SetAdvancedMode(true)">
                @L("All pages", "Tất cả trang")
            </button>
        </div>

        <ul class="nav flex-column">
            @* A single NavLink is kept across the loading and setup states so that finishing the
               background loading after the connection's services were disposed does not instantiate a new component. *@
            @if (this._isLoadingConfig || this._onlyShowSetup)
            {
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="@(this._isLoadingConfig ? string.Empty : "setup")" Match="@(this._isLoadingConfig ? NavLinkMatch.All : NavLinkMatch.Prefix)" @onclick="() => NavigationHistory.Clear()">
                        @if (this._isLoadingConfig)
                        {
                            <span class="oi oi-clock" aria-hidden="true"></span> @Resources.Loading
                        }
                        else
                        {
                            <span class="oi oi-cog" aria-hidden="true"></span> @Resources.Setup
                        }
                    </NavLink>
                </li>
            }
            else
            {
                @if (this.Preferences.Favourites.Count > 0)
                {
                    <li class="nav-section" role="presentation" id="nav-favourites">@L("Favourites", "Yêu thích")</li>
                    @foreach (var favRoute in this.Preferences.Favourites)
                    {
                        if (AdminNavCatalog.FindByRoute(favRoute) is { } fav)
                        {
                            <li class="nav-item px-3">
                                <NavLink class="nav-link py-1" href="@(string.IsNullOrEmpty(fav.Route) ? "" : fav.Route)" Match="@(string.IsNullOrEmpty(fav.Route) ? NavLinkMatch.All : NavLinkMatch.Prefix)" title="@fav.LocalizedDescription" @onclick="() => NavigationHistory.Clear()">
                                    <span class="oi oi-star text-warning" aria-hidden="true"></span> @fav.LocalizedTitle
                                </NavLink>
                            </li>
                        }
                    }
                }

                @if (this.Preferences.Recent.Count > 1)
                {
                    <li class="nav-section" role="presentation" id="nav-recent">@L("Recent", "Gần đây")</li>
                    @foreach (var recentRoute in this.Preferences.Recent.Skip(1).Take(4))
                    {
                        if (AdminNavCatalog.FindByRoute(recentRoute) is { } rec)
                        {
                            <li class="nav-item px-3">
                                <NavLink class="nav-link py-1" href="@(string.IsNullOrEmpty(rec.Route) ? "" : rec.Route)" Match="@(string.IsNullOrEmpty(rec.Route) ? NavLinkMatch.All : NavLinkMatch.Prefix)" title="@rec.LocalizedDescription" @onclick="() => NavigationHistory.Clear()">
                                    <span class="oi oi-clock" aria-hidden="true"></span> @rec.LocalizedTitle
                                </NavLink>
                            </li>
                        }
                    }
                }

                @foreach (var group in AdminNavCatalog.Groups)
                {
                    var items = group.Entries
                        .Where(IsCatalogVisibleInSidebar)
                        .Where(e => this.Preferences.AdvancedMode || e.IsBasic)
                        .ToList();
                    if (items.Count == 0)
                    {
                        continue;
                    }

                    <li class="nav-section" role="presentation" data-nav-group="@group.Id">
                        <span class="oi @group.Icon me-1" aria-hidden="true"></span> @group.LocalizedName
                    </li>
                    @foreach (var entry in items)
                    {
                        <li class="nav-item px-3">
                            <NavLink class="nav-link"
                                     href="@(string.IsNullOrEmpty(entry.Route) ? "" : entry.Route)"
                                     Match="@(string.IsNullOrEmpty(entry.Route) ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                                     title="@entry.LocalizedDescription"
                                     @onclick="() => NavigationHistory.Clear()">
                                <span class="oi @entry.Icon" aria-hidden="true"></span>
                                <span class="hn-nav-text">
                                    <span class="hn-nav-title">@entry.LocalizedTitle</span>
                                    @if (AdminNavHints.For(entry) is { Length: > 0 } hint)
                                    {
                                        <small class="hn-nav-desc">@hint</small>
                                    }
                                </span>
                            </NavLink>
                        </li>
                    }
                }

                @if (this.Preferences.AdvancedMode)
                {
                    <AuthorizeView Policy="@AdminPolicies.Administrator">
                        <li class="nav-section" role="presentation">@Resources.NavPlayerData</li>
                        <NavGroupMenu Groups="@PlayerDataGroups" />
                    </AuthorizeView>
                    @if (this.GameConfigurationId is { } gameConfigurationId)
                    {
                        <AuthorizeView Policy="@AdminPolicies.Administrator">
                            <li class="nav-section" role="presentation">@L("Schema editors", "Bảng dữ liệu gốc")</li>
                            <ConfigNavMenu GameConfigurationId="@gameConfigurationId" />
                        </AuthorizeView>
                    }
                }
            }
            <li class="nav-section" role="presentation">@Resources.NavAdministration</li>
            <li class="nav-item px-3 dropdown@(this._expandSystem ? " expanded" : "")">
                <a class="nav-link dropdown-toggle" href="" role="button" aria-haspopup="true" aria-expanded="@(this._expandSystem ? "true" : "false")" @onclick="this.ToggleSystem" @onclick:preventDefault="true">
                    <span class="oi oi-cog" aria-hidden="true"></span> @Resources.System
                    @if (!this._expandSystem && this._availableConfigUpdates > 0)
                    {
                        <span class="badge text-bg-light ms-2">@this._availableConfigUpdates</span>
                        <span class="visually-hidden">@Resources.AvailableUpdates</span>
                    }
                </a>
                <div class="dropdown-menu@(this._expandSystem ? " show" : "")">
                    @* The links of the configuration are only shown when it's loaded. The group itself is always rendered,
                       so that its authorization views don't get created again after the configuration was loaded. *@
                    @if (!this._isLoadingConfig && !this._onlyShowSetup)
                    {
                        <NavLink class="dropdown-item" href="setup" @onclick="() => NavigationHistory.Clear()">
                            <span class="oi oi-cog" aria-hidden="true"></span> @Resources.Setup
                        </NavLink>
                        <NavLink class="dropdown-item" href="config-updates" @onclick="() => NavigationHistory.Clear()">
                            <span class="oi oi-medical-cross" aria-hidden="true"></span> @Resources.Updates
                            @if (this._availableConfigUpdates > 0)
                            {
                                <span class="badge text-bg-light ms-2">@this._availableConfigUpdates</span>
                                <span class="visually-hidden">@Resources.AvailableUpdates</span>
                            }
                        </NavLink>
                        <NavLink class="dropdown-item" href="config-captions" @onclick="() => NavigationHistory.Clear()">
                            <span class="oi oi-globe" aria-hidden="true"></span> @Resources.Captions
                        </NavLink>
                    }
                    <AuthorizeView Policy="@AdminPolicies.Administrator">
                        <NavLink class="dropdown-item" href="seasons" @onclick="() => NavigationHistory.Clear()">
                            <span class="oi oi-globe" aria-hidden="true"></span> @Resources.SeasonsPageTitle
                        </NavLink>
                        <NavLink class="dropdown-item" href="users" @onclick="() => NavigationHistory.Clear()">
                            <span class="oi oi-key" aria-hidden="true"></span> @Resources.Users
                        </NavLink>
                        <NavLink class="dropdown-item" href="api-keys" @onclick="() => NavigationHistory.Clear()">
                            <span class="oi oi-share-boxed" aria-hidden="true"></span> @Resources.ApiKeys
                        </NavLink>
                        @if (AdminPanelEnvironment.IsHostingEmbedded)
                        {
                            <NavLink class="dropdown-item" href="discord" @onclick="() => NavigationHistory.Clear()">
                                <span class="oi oi-chat" aria-hidden="true"></span> @Resources.Discord
                            </NavLink>
                        }
                    </AuthorizeView>
                </div>
            </li>
            @if (AdminPanelEnvironment.IsHostingEmbedded || this.IsNetworkAnalyzerAvailable)
            {
                <li class="nav-item px-3 dropdown@(this._expandInspect ? " expanded" : "")">
                    <a class="nav-link dropdown-toggle" href="" role="button" aria-haspopup="true" aria-expanded="@(this._expandInspect ? "true" : "false")" @onclick="this.ToggleInspect" @onclick:preventDefault="true">
                        <span class="oi oi-magnifying-glass" aria-hidden="true"></span> @Resources.Inspect
                    </a>
                    <div class="dropdown-menu@(this._expandInspect ? " show" : "")">
                        @if (AdminPanelEnvironment.IsHostingEmbedded)
                        {
                            <NavLink class="dropdown-item" href="logfiles" @onclick="() => NavigationHistory.Clear()">
                                <span class="oi oi-list" aria-hidden="true"></span> @Resources.LogFiles
                            </NavLink>
                            <AuthorizeView Policy="@AdminPolicies.Administrator">
                                <NavLink class="dropdown-item" href="server-control">
                                    <span class="oi oi-power-standby me-1" aria-hidden="true"></span>@ServerControlText.Title
                                </NavLink>
                                <NavLink class="dropdown-item" href="host-settings" @onclick="() => NavigationHistory.Clear()">
                                    <span class="oi oi-wrench" aria-hidden="true"></span> @Resources.HostSettingsPage
                                </NavLink>
                            </AuthorizeView>
                            <AuthorizeView Policy="@AdminPolicies.Administrator">
                                <NavLink class="dropdown-item" href="logging-configuration" @onclick="() => NavigationHistory.Clear()">
                                    <span class="oi oi-wrench" aria-hidden="true"></span> @Resources.LoggingConfiguration
                                </NavLink>
                            </AuthorizeView>
                        }
                        @if (this.IsNetworkAnalyzerAvailable)
                        {
                            <AuthorizeView Policy="@AdminPolicies.Administrator">
                                <NavLink class="dropdown-item" href="network-analyzer" @onclick="() => NavigationHistory.Clear()">
                                    <span class="oi oi-pulse" aria-hidden="true"></span> @Resources.NetworkAnalyzer
                                </NavLink>
                            </AuthorizeView>
                        }
                    </div>
                </li>
            }
            @if (AdminPanelEnvironment.IsGrafanaAvailable)
            {
                <li class="nav-item px-3">
                    <a class="nav-link" href="/grafana/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%2C%22expr%22%3A%22%7Bservice_name%3D~%5C%22.%2B%5C%22%7D%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D"
                       target="_blank">
                        <span class="oi oi-list" aria-hidden="true"></span> @Resources.Logs
                    </a>
                </li>
            }
        </ul>
    </div>
</nav>
