{
  "name": "hnmo-web",
  "version": "0.1.0",
  "private": true,
  "description": "HNMO web client.",
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch --preserveWatchOutput",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.tests.json",
    "start": "npm run build && dotnet run --project bridge -c Release",
    "generate-packets": "node tools/generate-packets.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.160.0",
    "esbuild": "^0.24.2",
    "fast-xml-parser": "^4.5.0",
    "typescript": "^5.6.3"
  }
}
