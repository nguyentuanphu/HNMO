<rml>
<head>
	<title>HNMO Gift code</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/template" href="window_shell.rml"/>
	<style>
		/* HNMO's gift code window (no desktop window): the game's message box frame (window_shell) with the code field,
		   the result of the last code, the rewards waiting for room in the bag and the account's last codes. */
		#panel {
			top: 50dp;
			left: 50%;
			margin-left: -150dp;
			transform: none;
			width: 300dp;
			height: auto;
			font-family: "token(font-body)";
			font-size: 1rem;
			color: token(text-primary);
		}
		#panel .window-shell-content {
			position: relative;
			top: auto;
			bottom: auto;
			left: auto;
			right: auto;
			margin: 20dp 14dp 18dp 14dp;
			z-index: 1;
			align-items: stretch;
		}
		#panel .window-shell-content.has-title { margin-top: 0; }
		#panel .window-shell-header-title { color: token(accent-gold); }
		.gc-scroll { display: block; max-height: 360dp; overflow-y: auto; pointer-events: auto; padding-right: 4dp; }
		.gc-head { display: block; color: token(accent-gold); margin: 6dp 0 2dp 0; }
		.gc-line { display: block; line-height: 1.3em; white-space: normal; color: token(text-input); font-size: 0.9rem; }
		.gc-line.muted { color: token(text-muted); font-size: 0.85rem; }
		.gc-line.done { color: #9fe39a; }
		.gc-code { display: block; text-align: center; color: #ffe9a8; font-size: 1.15rem; line-height: 1.5em; }
		.gc-event { display: block; margin: 3dp 0; padding: 3dp 4dp; border: 1dp #4a3c26; background-color: #15110b; }
		.gc-event-title { display: block; color: #ffe9a8; line-height: 1.3em; }
		.gc-note { display: block; margin: 2dp 0 4dp 0; font-size: 0.85rem; line-height: 1.25em; text-align: center; color: token(text-muted); white-space: normal; }
		.gc-field { display: flex; flex-direction: row; align-items: center; margin-top: 3dp; pointer-events: auto; }
		.gc-field input { flex: 1 1 auto; height: 16dp; padding: 0 3dp; margin-right: 6dp; }
		.gc-buttons { display: flex; flex-direction: row; justify-content: center; flex-wrap: wrap; margin-top: 4dp; }
		@spritesheet gc-btn-sheet
		{
			src: "../newui_btn_empty_small.tga"; /* Data/Interface */
			gc-btn-idle:   0px  0px 64px 29px;
			gc-btn-hover:  0px 29px 64px 29px;
			gc-btn-active: 0px 58px 64px 29px;
		}
		.gc-btn {
			position: static;
			width: 76dp;
			height: 28dp;
			line-height: 28dp;
			margin: 2dp 3dp;
			font-size: 0.85rem;
			pointer-events: auto;
			cursor: pointer;
			decorator: image(gc-btn-idle);
		}
		.gc-btn:hover { decorator: image(gc-btn-hover); }
		.gc-btn:active { decorator: image(gc-btn-active); }
		.gc-btn.go { color: #ffe9a8; }
			.gc-result { display: block; margin: 4dp 0; line-height: 1.3em; white-space: normal; color: #ffb4a8; font-size: 0.9rem; }
		.gc-result.done { color: #9fe39a; }
	</style>
</head>
<body template="window_shell" data-model="hnmo_gift_codes">
	<div class="gc-scroll">
		<span class="gc-line muted">{{intro_text}}</span>
		<div class="gc-field">
			<input type="text" class="text-field gc-code-input" maxlength="32" data-value="code_input" data-attr-placeholder="code_placeholder"/>
			<div class="btn gc-btn go gc-send" data-event-click="gc_send">{{enter_label}}</div>
		</div>
		<span class="gc-result" data-if="result_text != ''" data-class-done="result_ok" data-no-i18n="">{{result_text}}</span>

		<span class="gc-head" data-if="has_owed">{{owed_head}}</span>
		<span class="gc-line gc-owed" data-for="o : owed" data-no-i18n="">{{o.line}}</span>
		<div class="gc-buttons" data-if="has_owed"><div class="btn gc-btn go gc-claim" data-event-click="gc_claim">{{take_label}}</div></div>

		<span class="gc-head" data-if="has_recent">{{recent_head}}</span>
		<span class="gc-line muted gc-recent" data-for="r : recent" data-no-i18n="">{{r.line}}</span>
		<span class="gc-note">{{hint_text}}</span>
	</div>
	<div class="gc-buttons">
		<div class="btn gc-btn gc-close" data-event-click="gc_close">{{close_label}}</div>
	</div>
</body>
</rml>
